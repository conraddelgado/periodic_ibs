{
  "periodic": [true, true, true],
  "grid": {
    "shape": [512, 256, 256],
    "lengths": [2.0, 1.0, 1.0],
    "origin": [0.0, 0.0, 0.0]
  },
  "physics": {
    "eos": "ideal_gas",
    "transport": "constant",
    "gamma": 1.4,
    "gas_constant": 287.0,
    "mu": 0.000018,
    "conductivity": 0.026
  },
  "io": {
    "format": "shared",
    "dtype": "<f8",
    "particle_dtype": "<f8",
    "nvars": 6,
    "indices": {"rho": 1, "momentum": [2, 3, 4], "energy": 5},
    "flow": "restart_data/{step}.dat",
    "particles": "restart_data/ib_state_{step}.dat"
  },
  "snapshots": [1000, 2000, 3000],
  "sigmas": [0.025, 0.05],
  "alpha_min": 0.000001,
  "fft_workers": 4,
  "surface": {
    "polar_points": 16,
    "offset_cells": 2.0,
    "velocity_bc": "no_slip",
    "thermal_bc": "adiabatic"
  },
  "map": {
    "kind": "box",
    "length": 0.2,
    "points": 21
  },
  "output": "closure_statistics.npz"
}
